{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [ "NDMicroAsm/NDMicroAsm.csproj" ],
          "exclude": [ "**/*.Tests/**", "**/tests/**", "**/tools/**", "**/obj/**", "**/bin/**" ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "nested",
      "memberLayout": "samePage",
      "allowCompilationErrors": false,
      "outputFormat": "mref"
    }
  ],
  "build": {
    "content": [
      { "files": [ "api/**.yml", "api/index.md" ] },
      { "files": [ "*.md", "toc.yml" ] },
      { "files": [ "docs/**.md", "docs/toc.yml", "NDMicroAsm/microcode/**/*.md", "CHANGELOG.md" ], "src": ".." }
    ],
    "resource": [
      { "files": [ "images/**" ] },
      { "files": [ "assets/NDMicroAsm.svg", "assets/NDMicroAsm.ico" ], "src": "..", "dest": "" }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "NDMicroAsm",
      "_appTitle": "NDMicroAsm",
      "_appLogoPath": "assets/NDMicroAsm.svg",
      "_appFaviconPath": "assets/NDMicroAsm.ico",
      "_appFooter": "Copyright (c) 1985-2026 Ronny Hansen - MIT License - RetroCore Labs - <a href=\"https://github.com/RetroCoreLabs/NDMicroAsm\">NDMicroAsm on GitHub</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/RetroCoreLabs/NDMicroAsm",
        "branch": "main"
      }
    },
    "template": [ "default", "modern", "template" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
